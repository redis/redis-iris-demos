# Radish Bank MongoDB -> RDI -> Redis Iris workshop credentials
# Copy this file to .env in the same directory and fill in the values:
#   cp notebooks/radish_bank_mongo_rdi/.env.example notebooks/radish_bank_mongo_rdi/.env

# Active demo domain
DEMO_DOMAIN=radish-bank

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Redis Cloud database used for JSON records, Context Retriever indexes, and app state
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=true
REDIS_DB=0

# Context Retriever / Context Surfaces
CTX_ADMIN_KEY=
CTX_SURFACE_ID=
MCP_AGENT_KEY=

# Agent Memory
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=
MEMORY_ACTOR_ID=iris-agent
MEMORY_NAMESPACE=radish-bank-workshop
MEMORY_LIMIT=6
# Optional. Radish Bank defaults to 0.5 when unset.
# MEMORY_SIMILARITY_THRESHOLD=0.5

# LangCache
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_THRESHOLD=0.82

# Local MongoDB source for this workshop
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=radish_bank_workshop

# Copy to terraform.tfvars (gitignored) or pass -var / TF_VAR_*.
# Required GCP identity: Application Default Credentials for a principal that can
# create GKE clusters in project_id.

project_id   = "YOUR_GCP_PROJECT_ID"
region       = "us-central1"
zone         = "us-central1-a"
cluster_name = "meeting-intel-rdi"

# Appropriately sized for RDI + Redis Enterprise operator + in-cluster Postgres.
machine_type = "e2-standard-4"
node_count   = 3
disk_size_gb = 100

rdi_chart_version = "1.14.0"

# Target Redis = the same Redis Cloud DB redis-iris-demos already uses.
# Fill from environment / .env — do not commit real values.
redis_host     = "YOUR_REDIS_HOST"
redis_port     = 14431
redis_username = "default"
redis_password = "YOUR_REDIS_PASSWORD"
redis_ssl      = false
